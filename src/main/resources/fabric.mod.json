{
  "schemaVersion": 1,
  "id": "wandererz",
  "version": "${version}",
  "name": "WandererZ",
  "description": "Adds player levels, now with integrated Jobs and RPG Difficulty",
  "authors": [
    "Globox_Z"
  ],
  "contact": {
    "homepage": "https://github.com/Atlasroar/LevelZ",
    "sources": "https://github.com/Atlasroar/LevelZ",
    "issues": "https://github.com/Atlasroar/LevelZ/issues"
  },
  "license": "GPLv3",
  "icon": "assets/wandererz/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.wandererz.WandererzMain",
      "net.jobsaddon.JobsAddonMain",
      "net.rpgdifficulty.RpgDifficultyMain"
    ],
    "client": [
      "net.wandererz.WandererzClient",
      "net.jobsaddon.JobsAddonClient",
      "net.rpgdifficulty.RpgDifficultyClient"
    ],
    "modmenu": [
      "net.wandererz.config.ModMenuIntegration"
    ],
    "emi": [
      "net.wandererz.compat.WandererzEmiPlugin"
    ],
    "rei_client": [
      "net.wandererz.compat.WandererzReiPlugin"
    ],
    "jade": [
      "net.wandererz.waila.LevelJadePlugin"
    ]
  },
  "mixins": [
    "wandererz.mixins.json",
    "jobsaddon.mixins.json",
    "rpgdifficulty.mixins.json"
  ],
  "depends": {
    "java": ">=17",
    "minecraft": ">=${minecraft_version}",
    "fabric-api": ">=${fabric_version}",
    "fabricloader": ">=${loader_version}",
    "cloth-config2": ">=${cloth_config_version}",
    "libz": "*"
  },
  "suggests": {},
  "custom": {
    "waila:plugins": {
      "id": "wandererz:plugin",
      "environment": "client",
      "initializer": "net.wandererz.waila.LevelWailaPlugin"
    }
  }
}